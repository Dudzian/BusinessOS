<Window x:Class="BusinessOS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BusinessOS">
 <ScrollViewer><Grid Padding="32" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Text="{Binding Shell.Title}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.Version}"/><TextBlock Text="Baza danych jest gotowa" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Firmy" Click="CompaniesSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="CompaniesSectionButton"/><Button Content="Projekty" Click="ProjectsSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BusinessProjectsSectionButton"/><Button Content="Budżety" Click="BudgetingSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BudgetingSectionButton"/><Button Content="Koszty rzeczywiste" Click="ActualCostsSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="ActualCostsSectionButton"/><Button Content="Prognoza kosztów" Click="ForecastCostsSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="ForecastCostsSectionButton"/><Button Content="Plan vs wykonanie" Click="BudgetVarianceSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BudgetVarianceSectionButton"/><Button Content="Kopie zapasowe" Click="Recovery_Click" IsEnabled="{Binding Workspace.CanOpenRecovery}" AutomationProperties.AutomationId="OpenRecoveryFromMainButton"/></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding BudgetVarianceVisibility}" Spacing="12" AutomationProperties.AutomationId="BudgetVarianceSectionPanel">
   <TextBlock Text="Plan vs wykonanie" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding BudgetVariance.Projects}" SelectedItem="{Binding BudgetVariance.SelectedProject, Mode=OneWay}" SelectionChanged="BudgetVarianceProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding BudgetVariance.CanSelectProject}" AutomationProperties.AutomationId="BudgetVarianceProjectSelector"/><ComboBox Header="Budżet" ItemsSource="{Binding BudgetVariance.Budgets}" SelectedItem="{Binding BudgetVariance.SelectedBudget, Mode=OneWay}" SelectionChanged="BudgetVarianceBudgetSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding BudgetVariance.CanSelectBudget}" AutomationProperties.AutomationId="BudgetVarianceBudgetSelector"/><ComboBox Header="Wersja" ItemsSource="{Binding BudgetVariance.Versions}" SelectedItem="{Binding BudgetVariance.SelectedVersion, Mode=OneWay}" SelectionChanged="BudgetVarianceVersionSelector_SelectionChanged" DisplayMemberPath="Label" IsEnabled="{Binding BudgetVariance.CanSelectVersion}" AutomationProperties.AutomationId="BudgetVarianceVersionSelector"/>
   <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="{Binding BudgetVariance.ProjectCurrency}" AutomationProperties.AutomationId="BudgetVarianceCurrency"/><TextBlock Text="{Binding BudgetVariance.BudgetStatus}" AutomationProperties.AutomationId="BudgetVarianceBudgetStatus"/><Button Content="Odśwież" Click="BudgetVarianceRefresh_Click" IsEnabled="{Binding BudgetVariance.CanRefresh}" AutomationProperties.AutomationId="RefreshBudgetVarianceButton"/></StackPanel>
   <TextBlock Text="CAPEX" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetVariance.CapexPlanned}" AutomationProperties.AutomationId="BudgetVarianceCapexPlanned"/><TextBlock Text="{Binding BudgetVariance.CapexActual}" AutomationProperties.AutomationId="BudgetVarianceCapexActual"/><TextBlock Text="{Binding BudgetVariance.CapexVariance}" AutomationProperties.AutomationId="BudgetVarianceCapexVariance"/><TextBlock Text="{Binding BudgetVariance.CapexUtilization}" AutomationProperties.AutomationId="BudgetVarianceCapexUtilization"/><TextBlock Text="{Binding BudgetVariance.CapexState}" AutomationProperties.AutomationId="BudgetVarianceCapexState"/></StackPanel>
   <TextBlock Text="OPEX" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetVariance.OpexPlanned}" AutomationProperties.AutomationId="BudgetVarianceOpexPlanned"/><TextBlock Text="{Binding BudgetVariance.OpexActual}" AutomationProperties.AutomationId="BudgetVarianceOpexActual"/><TextBlock Text="{Binding BudgetVariance.OpexVariance}" AutomationProperties.AutomationId="BudgetVarianceOpexVariance"/><TextBlock Text="{Binding BudgetVariance.OpexUtilization}" AutomationProperties.AutomationId="BudgetVarianceOpexUtilization"/><TextBlock Text="{Binding BudgetVariance.OpexState}" AutomationProperties.AutomationId="BudgetVarianceOpexState"/></StackPanel>
   <TextBlock Text="TOTAL EXPENSES" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetVariance.TotalPlanned}" AutomationProperties.AutomationId="BudgetVarianceTotalPlanned"/><TextBlock Text="{Binding BudgetVariance.TotalActual}" AutomationProperties.AutomationId="BudgetVarianceTotalActual"/><TextBlock Text="{Binding BudgetVariance.TotalVariance}" AutomationProperties.AutomationId="BudgetVarianceTotalVariance"/><TextBlock Text="{Binding BudgetVariance.TotalUtilization}" AutomationProperties.AutomationId="BudgetVarianceTotalUtilization"/><TextBlock Text="{Binding BudgetVariance.TotalState}" AutomationProperties.AutomationId="BudgetVarianceTotalState"/></StackPanel><TextBlock Text="{Binding BudgetVariance.OperationMessage}" AutomationProperties.AutomationId="BudgetVarianceOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding CompaniesVisibility}" Spacing="12" AutomationProperties.AutomationId="CompaniesSectionPanel">
   <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Firmy" FontSize="24"/><Button Content="Dodaj" Click="Add_Click" IsEnabled="{Binding Companies.CanAdd}" AutomationProperties.AutomationId="AddCompanyButton"/><Button Content="Edytuj" Click="Edit_Click" IsEnabled="{Binding Companies.CanEdit}" AutomationProperties.AutomationId="EditCompanyButton"/><Button Content="Archiwizuj" Click="Archive_Click" IsEnabled="{Binding Companies.CanArchive}" AutomationProperties.AutomationId="ArchiveCompanyButton"/><Button Content="Odśwież" Click="Refresh_Click" IsEnabled="{Binding Companies.CanRefresh}" AutomationProperties.AutomationId="RefreshCompaniesButton"/></StackPanel>
   <TextBlock Text="Brak firm. Dodaj pierwszą firmę." Visibility="{Binding CompaniesEmptyVisibility}" AutomationProperties.AutomationId="CompaniesEmptyState"/>
   <ListView ItemsSource="{Binding Companies.Companies}" SelectedItem="{Binding Companies.SelectedCompany, Mode=TwoWay}" IsEnabled="{Binding Companies.CanSelectList}" AutomationProperties.AutomationId="CompaniesList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding LegalName}"/><TextBlock><Run Text="{Binding BaseCurrency}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Visibility="{Binding CompanyEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="CompanyEditorPanel"><TextBox Header="Nazwa prawna" Text="{Binding Companies.LegalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyLegalNameInput"/><TextBox Header="Nazwa wyświetlana" Text="{Binding Companies.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyDisplayNameInput"/><TextBox Header="NIP / numer podatkowy" Text="{Binding Companies.TaxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyTaxIdInput"/><TextBox Header="Kod kraju" Text="{Binding Companies.CountryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyCountryInput"/><TextBox Header="Waluta bazowa" Text="{Binding Companies.BaseCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyCurrencyInput"/><TextBox Header="Strefa czasowa" Text="{Binding Companies.DefaultTimeZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyTimeZoneInput"/><ComboBox Header="Status" SelectedItem="{Binding Companies.Status, Mode=TwoWay}" ItemsSource="{Binding CompanyStatuses}" AutomationProperties.AutomationId="CompanyStatusInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="Save_Click" IsEnabled="{Binding Companies.CanSave}" AutomationProperties.AutomationId="SaveCompanyButton"/><Button Content="Anuluj" Click="Cancel_Click" IsEnabled="{Binding Companies.CanCancel}" AutomationProperties.AutomationId="CancelCompanyButton"/></StackPanel></StackPanel>
   <TextBlock Text="{Binding Companies.OperationMessage}" AutomationProperties.AutomationId="CompanyOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding ActualCostsVisibility}" Spacing="12" AutomationProperties.AutomationId="ActualCostsSectionPanel">
   <TextBlock Text="Koszty rzeczywiste" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding ActualCosts.Projects}" SelectedItem="{Binding ActualCosts.SelectedProject, Mode=OneWay}" SelectionChanged="ActualCostsProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding ActualCosts.CanSelectProject}" AutomationProperties.AutomationId="ActualCostsProjectSelector"/><TextBlock Text="{Binding ActualCosts.ProjectCurrency}" AutomationProperties.AutomationId="ActualCostsProjectCurrency"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Odśwież" Click="ActualCostsRefresh_Click" IsEnabled="{Binding ActualCosts.CanRefresh}" AutomationProperties.AutomationId="RefreshActualCostsButton"/><Button Content="Dodaj" Click="ActualCostAdd_Click" IsEnabled="{Binding ActualCosts.CanAddCost}" AutomationProperties.AutomationId="AddActualCostButton"/><Button Content="Edytuj" Click="ActualCostEdit_Click" IsEnabled="{Binding ActualCosts.CanEditCost}" AutomationProperties.AutomationId="EditActualCostButton"/><Button Content="Archiwizuj" Click="ActualCostArchive_Click" IsEnabled="{Binding ActualCosts.CanArchiveCost}" AutomationProperties.AutomationId="ArchiveActualCostButton"/></StackPanel>
   <TextBlock Text="Brak kosztów." Visibility="{Binding ActualCostsEmptyVisibility}" AutomationProperties.AutomationId="ActualCostsEmptyState"/><ListView ItemsSource="{Binding ActualCosts.Costs}" SelectedItem="{Binding ActualCosts.SelectedCost, Mode=OneWay}" SelectionChanged="ActualCostsList_SelectionChanged" IsEnabled="{Binding ActualCosts.CanSelectCost}" AutomationProperties.AutomationId="ActualCostsList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Amount}"/><Run Text=" "/><Run Text="{Binding Currency}"/><Run Text=" · "/><Run Text="{Binding IncurredOn}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock AutomationProperties.AutomationId="ActualCostCapexTotal"><Run Text="CAPEX: "/><Run Text="{Binding ActualCosts.CapexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ActualCostOpexTotal"><Run Text="OPEX: "/><Run Text="{Binding ActualCosts.OpexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ActualCostTotal"><Run Text="Total: "/><Run Text="{Binding ActualCosts.TotalCost}"/></TextBlock></StackPanel>
   <StackPanel Visibility="{Binding ActualCostEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="ActualCostEditorPanel"><ComboBox Header="Rodzaj" ItemsSource="{Binding ActualCosts.CostKinds}" SelectedItem="{Binding ActualCosts.CostKind, Mode=TwoWay}" AutomationProperties.AutomationId="ActualCostKindInput"/><TextBox Header="Nazwa" Text="{Binding ActualCosts.CostName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ActualCostNameInput"/><TextBox Header="Kwota" Text="{Binding ActualCosts.CostAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ActualCostAmountInput"/><CalendarDatePicker Header="Data" Date="{Binding ActualCostDate, Mode=TwoWay}" AutomationProperties.AutomationId="ActualCostDateInput"/><TextBox Header="Notatka" Text="{Binding ActualCosts.CostNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ActualCostNoteInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="ActualCostSave_Click" IsEnabled="{Binding ActualCosts.CanSaveCost}" AutomationProperties.AutomationId="SaveActualCostButton"/><Button Content="Anuluj" Click="ActualCostCancel_Click" IsEnabled="{Binding ActualCosts.CanCancelEditor}" AutomationProperties.AutomationId="CancelActualCostButton"/></StackPanel></StackPanel><TextBlock Text="{Binding ActualCosts.OperationMessage}" AutomationProperties.AutomationId="ActualCostsOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding ForecastCostsVisibility}" Spacing="12" AutomationProperties.AutomationId="ForecastCostsSectionPanel">
   <TextBlock Text="Prognoza kosztów" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding ForecastCosts.Projects}" SelectedItem="{Binding ForecastCosts.SelectedProject, Mode=OneWay}" SelectionChanged="ForecastCostsProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding ForecastCosts.CanSelectProject}" AutomationProperties.AutomationId="ForecastCostsProjectSelector"/><TextBlock Text="{Binding ForecastCosts.ProjectCurrency}" AutomationProperties.AutomationId="ForecastCostsProjectCurrency"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Odśwież" Click="ForecastCostsRefresh_Click" IsEnabled="{Binding ForecastCosts.CanRefresh}" AutomationProperties.AutomationId="RefreshForecastCostsButton"/><Button Content="Dodaj" Click="ForecastCostAdd_Click" IsEnabled="{Binding ForecastCosts.CanAddForecast}" AutomationProperties.AutomationId="AddForecastCostButton"/><Button Content="Edytuj" Click="ForecastCostEdit_Click" IsEnabled="{Binding ForecastCosts.CanEditForecast}" AutomationProperties.AutomationId="EditForecastCostButton"/><Button Content="Archiwizuj" Click="ForecastCostArchive_Click" IsEnabled="{Binding ForecastCosts.CanArchiveForecast}" AutomationProperties.AutomationId="ArchiveForecastCostButton"/></StackPanel>
   <TextBlock Text="Brak prognoz." Visibility="{Binding ForecastCostsEmptyVisibility}" AutomationProperties.AutomationId="ForecastCostsEmptyState"/><ListView ItemsSource="{Binding ForecastCosts.ForecastCosts}" SelectedItem="{Binding ForecastCosts.SelectedForecastCost, Mode=OneWay}" SelectionChanged="ForecastCostsList_SelectionChanged" IsEnabled="{Binding ForecastCosts.CanSelectForecast}" AutomationProperties.AutomationId="ForecastCostsList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Amount}"/><Run Text=" "/><Run Text="{Binding Currency}"/><Run Text=" · "/><Run Text="{Binding ExpectedOn}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock AutomationProperties.AutomationId="ForecastCostCapexTotal"><Run Text="CAPEX: "/><Run Text="{Binding ForecastCosts.ForecastCapexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ForecastCostOpexTotal"><Run Text="OPEX: "/><Run Text="{Binding ForecastCosts.ForecastOpexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ForecastCostTotal"><Run Text="Total: "/><Run Text="{Binding ForecastCosts.ForecastTotal}"/></TextBlock></StackPanel>
   <StackPanel Visibility="{Binding ForecastCostEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="ForecastCostEditorPanel"><ComboBox Header="Rodzaj" ItemsSource="{Binding ForecastCosts.ForecastKinds}" SelectedItem="{Binding ForecastCosts.ForecastKind, Mode=TwoWay}" AutomationProperties.AutomationId="ForecastCostKindInput"/><TextBox Header="Nazwa" Text="{Binding ForecastCosts.ForecastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ForecastCostNameInput"/><TextBox Header="Kwota" Text="{Binding ForecastCosts.ForecastAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ForecastCostAmountInput"/><CalendarDatePicker Header="Data" Date="{Binding ForecastCostExpectedDate, Mode=TwoWay}" AutomationProperties.AutomationId="ForecastCostExpectedDateInput"/><TextBox Header="Notatka" Text="{Binding ForecastCosts.ForecastNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ForecastCostNoteInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="ForecastCostSave_Click" IsEnabled="{Binding ForecastCosts.CanSaveForecast}" AutomationProperties.AutomationId="SaveForecastCostButton"/><Button Content="Anuluj" Click="ForecastCostCancel_Click" IsEnabled="{Binding ForecastCosts.CanCancelEditor}" AutomationProperties.AutomationId="CancelForecastCostButton"/></StackPanel></StackPanel><TextBlock Text="{Binding ForecastCosts.OperationMessage}" AutomationProperties.AutomationId="ForecastCostsOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding ProjectsVisibility}" Spacing="12" AutomationProperties.AutomationId="BusinessProjectsSectionPanel">
   <TextBlock Text="Projekty" FontSize="24"/><ComboBox Header="Firma" ItemsSource="{Binding Projects.Companies}" SelectedItem="{Binding Projects.SelectedCompany, Mode=OneWay}" SelectionChanged="BusinessProjectsCompanySelector_SelectionChanged" DisplayMemberPath="DisplayName" IsEnabled="{Binding Projects.CanSelectCompany}" AutomationProperties.AutomationId="BusinessProjectsCompanySelector"/><ComboBox Header="Status (puste = Wszystkie)" ItemsSource="{Binding Projects.StatusFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Projects.SelectedStatusFilter, Mode=OneWay}" SelectionChanged="BusinessProjectsStatusFilter_SelectionChanged" IsEnabled="{Binding Projects.CanChangeFilter}" AutomationProperties.AutomationId="BusinessProjectsStatusFilter"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Odśwież" Click="ProjectsRefresh_Click" IsEnabled="{Binding Projects.CanRefresh}" AutomationProperties.AutomationId="RefreshBusinessProjectsButton"/><Button Content="Dodaj" Click="ProjectAdd_Click" IsEnabled="{Binding Projects.CanAdd}" AutomationProperties.AutomationId="AddBusinessProjectButton"/><Button Content="Edytuj" Click="ProjectEdit_Click" IsEnabled="{Binding Projects.CanEdit}" AutomationProperties.AutomationId="EditBusinessProjectButton"/><Button Content="Zmień status" Click="ProjectStatus_Click" IsEnabled="{Binding Projects.CanChangeStatus}" AutomationProperties.AutomationId="ChangeBusinessProjectStatusButton"/><Button Content="Archiwizuj" Click="ProjectArchive_Click" IsEnabled="{Binding Projects.CanArchive}" AutomationProperties.AutomationId="ArchiveBusinessProjectButton"/></StackPanel>
   <TextBlock Text="Brak projektów." Visibility="{Binding ProjectsEmptyVisibility}" AutomationProperties.AutomationId="BusinessProjectsEmptyState"/>
   <ListView ItemsSource="{Binding Projects.Projects}" SelectedItem="{Binding Projects.SelectedProject, Mode=TwoWay}" IsEnabled="{Binding Projects.CanSelectProject}" AutomationProperties.AutomationId="BusinessProjectsList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding BusinessType}"/><Run Text=" · "/><Run Text="{Binding Location}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock><TextBlock><Run Text="{Binding PlannedStartDate}"/><Run Text=" → "/><Run Text="{Binding PlannedOpeningDate}"/><Run Text=" · "/><Run Text="{Binding BaseCurrency}"/></TextBlock><TextBlock Text="{Binding UpdatedAtUtc}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Visibility="{Binding ProjectEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="BusinessProjectEditorPanel"><TextBox Header="Nazwa projektu" Text="{Binding Projects.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectNameInput"/><TextBox Header="Typ biznesu" Text="{Binding Projects.BusinessType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectTypeInput"/><TextBox Header="Lokalizacja" Text="{Binding Projects.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectLocationInput"/><TextBox Header="Opis" Text="{Binding Projects.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.AutomationId="BusinessProjectDescriptionInput"/><CalendarDatePicker Header="Planowana data rozpoczęcia" Date="{Binding ProjectStartDate, Mode=TwoWay}" AutomationProperties.AutomationId="BusinessProjectStartDateInput"/><CalendarDatePicker Header="Planowana data otwarcia" Date="{Binding ProjectOpeningDate, Mode=TwoWay}" AutomationProperties.AutomationId="BusinessProjectOpeningDateInput"/><TextBox Header="Waluta bazowa" Text="{Binding Projects.BaseCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectCurrencyInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="ProjectSave_Click" IsEnabled="{Binding Projects.CanSave}" AutomationProperties.AutomationId="SaveBusinessProjectButton"/><Button Content="Anuluj" Click="ProjectCancel_Click" IsEnabled="{Binding Projects.CanCancel}" AutomationProperties.AutomationId="CancelBusinessProjectButton"/></StackPanel></StackPanel>
   <TextBlock Text="{Binding Projects.OperationMessage}" AutomationProperties.AutomationId="BusinessProjectOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding BudgetingVisibility}" Spacing="12" AutomationProperties.AutomationId="BudgetingSectionPanel">
   <TextBlock Text="Budżety" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding Budgeting.Projects}" SelectedItem="{Binding Budgeting.SelectedProject, Mode=OneWay}" SelectionChanged="BudgetingProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding Budgeting.CanSelectProject}" AutomationProperties.AutomationId="BudgetingProjectSelector"/><TextBlock><Run Text="Waluta projektu: "/><Run Text="{Binding Budgeting.ProjectCurrency}"/></TextBlock><TextBlock Text="{Binding Budgeting.ProjectCurrency}" AutomationProperties.AutomationId="BudgetProjectCurrency"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Odśwież" Click="BudgetRefresh_Click" IsEnabled="{Binding Budgeting.CanRefresh}" AutomationProperties.AutomationId="RefreshBudgetsButton"/><Button Content="Dodaj" Click="BudgetAdd_Click" IsEnabled="{Binding Budgeting.CanAddBudget}" AutomationProperties.AutomationId="AddBudgetButton"/><Button Content="Zmień nazwę" Click="BudgetRename_Click" IsEnabled="{Binding Budgeting.CanRenameBudget}" AutomationProperties.AutomationId="RenameBudgetButton"/><Button Content="Aktywuj" Click="BudgetActivate_Click" IsEnabled="{Binding Budgeting.CanActivateBudget}" AutomationProperties.AutomationId="ActivateBudgetButton"/><Button Content="Archiwizuj" Click="BudgetArchive_Click" IsEnabled="{Binding Budgeting.CanArchiveBudget}" AutomationProperties.AutomationId="ArchiveBudgetButton"/></StackPanel>
   <TextBlock Text="Brak budżetów." Visibility="{Binding BudgetsEmptyVisibility}" AutomationProperties.AutomationId="BudgetsEmptyState"/><ListView ItemsSource="{Binding Budgeting.Budgets}" SelectedItem="{Binding Budgeting.SelectedBudget, Mode=OneWay}" SelectionChanged="BudgetsList_SelectionChanged" IsEnabled="{Binding Budgeting.CanSelectBudget}" AutomationProperties.AutomationId="BudgetsList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding Status}"/><Run Text=" · Version "/><Run Text="{Binding LatestVersion}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Visibility="{Binding BudgetEditorVisibility}" Spacing="8"><TextBox Header="Nazwa budżetu" Text="{Binding Budgeting.BudgetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BudgetNameInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="BudgetSave_Click" IsEnabled="{Binding Budgeting.CanSaveBudget}" AutomationProperties.AutomationId="SaveBudgetButton"/><Button Content="Anuluj" Click="BudgetCancel_Click" IsEnabled="{Binding Budgeting.CanCancelBudgetEditor}" AutomationProperties.AutomationId="CancelBudgetButton"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Utwórz Version 1" Click="InitialVersion_Click" IsEnabled="{Binding Budgeting.CanCreateInitialVersion}" AutomationProperties.AutomationId="CreateInitialBudgetVersionButton"/><Button Content="Utwórz kolejną wersję" Click="NextVersion_Click" IsEnabled="{Binding Budgeting.CanCreateNextVersion}" AutomationProperties.AutomationId="CreateNextBudgetVersionButton"/></StackPanel><ListView ItemsSource="{Binding Budgeting.Versions}" SelectedItem="{Binding Budgeting.SelectedVersion, Mode=OneWay}" SelectionChanged="BudgetVersionsList_SelectionChanged" IsEnabled="{Binding Budgeting.CanSelectVersion}" AutomationProperties.AutomationId="BudgetVersionsList"><ListView.ItemTemplate><DataTemplate><TextBlock><Run Text="Version "/><Run Text="{Binding Number}"/></TextBlock></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock AutomationProperties.AutomationId="BudgetCapexTotal"><Run Text="CAPEX: "/><Run Text="{Binding Budgeting.CapexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="BudgetOpexTotal"><Run Text="OPEX: "/><Run Text="{Binding Budgeting.OpexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="BudgetRevenueTotal"><Run Text="Revenue: "/><Run Text="{Binding Budgeting.RevenueTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="BudgetFinancingTotal"><Run Text="Financing: "/><Run Text="{Binding Budgeting.FinancingTotal}"/></TextBlock></StackPanel>
   <ListView ItemsSource="{Binding Budgeting.Lines}" SelectedItem="{Binding Budgeting.SelectedLine, Mode=TwoWay}" IsEnabled="{Binding Budgeting.CanSelectLine}" AutomationProperties.AutomationId="BudgetLinesList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}"/><TextBlock><Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Amount}"/><Run Text=" "/><Run Text="{Binding Currency}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Dodaj linię" Click="LineAdd_Click" IsEnabled="{Binding Budgeting.CanAddLine}" AutomationProperties.AutomationId="AddBudgetLineButton"/><Button Content="Edytuj linię" Click="LineEdit_Click" IsEnabled="{Binding Budgeting.CanEditLine}" AutomationProperties.AutomationId="EditBudgetLineButton"/><Button Content="Usuń linię" Click="LineRemove_Click" IsEnabled="{Binding Budgeting.CanRemoveLine}" AutomationProperties.AutomationId="RemoveBudgetLineButton"/></StackPanel>
   <StackPanel Visibility="{Binding LineEditorVisibility}" Spacing="8"><ComboBox Header="Kategoria" ItemsSource="{Binding Budgeting.LineKinds}" SelectedItem="{Binding Budgeting.LineKind, Mode=TwoWay}" AutomationProperties.AutomationId="BudgetLineKindInput"/><TextBox Header="Nazwa" Text="{Binding Budgeting.LineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BudgetLineNameInput"/><TextBox Header="Kwota" Text="{Binding Budgeting.LineAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BudgetLineAmountInput"/><TextBox Header="Kolejność" Text="{Binding Budgeting.LineSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BudgetLineSortOrderInput"/><TextBox Header="Notatka" Text="{Binding Budgeting.LineNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BudgetLineNoteInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="LineSave_Click" IsEnabled="{Binding Budgeting.CanSaveLine}" AutomationProperties.AutomationId="SaveBudgetLineButton"/><Button Content="Anuluj" Click="LineCancel_Click" IsEnabled="{Binding Budgeting.CanCancelLineEditor}" AutomationProperties.AutomationId="CancelBudgetLineButton"/></StackPanel></StackPanel>
   <TextBlock Text="{Binding Budgeting.OperationMessage}" AutomationProperties.AutomationId="BudgetingOperationMessage"/>
  </StackPanel>
 </Grid></ScrollViewer>
</Window>
