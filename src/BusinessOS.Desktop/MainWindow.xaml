<Window x:Class="BusinessOS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BusinessOS">
 <ScrollViewer><Grid Padding="32" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Text="{Binding Shell.Title}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.Version}"/><TextBlock Text="Baza danych jest gotowa" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Firmy" Click="CompaniesSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="CompaniesSectionButton"/><Button Content="Projekty" Click="ProjectsSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BusinessProjectsSectionButton"/><Button Content="Budżety" Click="BudgetingSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BudgetingSectionButton"/><Button Content="Koszty rzeczywiste" Click="ActualCostsSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="ActualCostsSectionButton"/><Button Content="Prognoza kosztów" Click="ForecastCostsSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="ForecastCostsSectionButton"/><Button Content="Plan vs prognoza" Click="BudgetForecastSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BudgetForecastSectionButton"/><Button Content="Plan vs wykonanie" Click="BudgetVarianceSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BudgetVarianceSectionButton"/><Button Content="Cash flow kosztów" Click="CostCashFlowSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="CostCashFlowSectionButton"/><Button Content="Faktury kosztowe" Click="SupplierInvoicesSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="SupplierInvoicesSectionButton"/><Button Content="Kopie zapasowe" Click="Recovery_Click" IsEnabled="{Binding Workspace.CanOpenRecovery}" AutomationProperties.AutomationId="OpenRecoveryFromMainButton"/></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding BudgetVarianceVisibility}" Spacing="12" AutomationProperties.AutomationId="BudgetVarianceSectionPanel">
   <TextBlock Text="Plan vs wykonanie" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding BudgetVariance.Projects}" SelectedItem="{Binding BudgetVariance.SelectedProject, Mode=OneWay}" SelectionChanged="BudgetVarianceProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding BudgetVariance.CanSelectProject}" AutomationProperties.AutomationId="BudgetVarianceProjectSelector"/><ComboBox Header="Budżet" ItemsSource="{Binding BudgetVariance.Budgets}" SelectedItem="{Binding BudgetVariance.SelectedBudget, Mode=OneWay}" SelectionChanged="BudgetVarianceBudgetSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding BudgetVariance.CanSelectBudget}" AutomationProperties.AutomationId="BudgetVarianceBudgetSelector"/><ComboBox Header="Wersja" ItemsSource="{Binding BudgetVariance.Versions}" SelectedItem="{Binding BudgetVariance.SelectedVersion, Mode=OneWay}" SelectionChanged="BudgetVarianceVersionSelector_SelectionChanged" DisplayMemberPath="Label" IsEnabled="{Binding BudgetVariance.CanSelectVersion}" AutomationProperties.AutomationId="BudgetVarianceVersionSelector"/>
