<Window
    x:Class="BusinessOS.Desktop.DatabaseRecoveryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BusinessOS — odzyskiwanie bazy danych">
    <Grid Padding="32" RowSpacing="16" AutomationProperties.AutomationId="RecoveryWindow">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="Przywracanie bazy danych" FontSize="28" FontWeight="SemiBold" AutomationProperties.AutomationId="RecoveryHeading" />
            <TextBlock Text="Przywrócenie kopii zastąpi aktualną bazę danych. Przed zmianą BusinessOS spróbuje utworzyć dodatkową kopię bezpieczeństwa." TextWrapping="Wrap" />
        </StackPanel>
        <ProgressRing x:Name="BusyRing" Grid.Row="1" IsActive="False" AutomationProperties.AutomationId="RecoveryProgressRing" />
        <ListView x:Name="BackupList" Grid.Row="2" SelectionChanged="BackupList_SelectionChanged" AutomationProperties.AutomationId="RecoveryBackupList">
            <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4" AutomationProperties.Name="{Binding AutomationName}">
                <TextBlock Text="{Binding CreatedText}" FontWeight="SemiBold"/><TextBlock Text="{Binding SizeText}"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
            </StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Name="EmptyText" Text="Nie znaleziono żadnych kopii zapasowych." Visibility="Collapsed" AutomationProperties.AutomationId="RecoveryEmptyState" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryStatusMessage" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryErrorMessage" />
            <TextBlock x:Name="DiagnosticText" AutomationProperties.AutomationId="RecoveryDiagnosticId" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
            <Button x:Name="RefreshButton" Content="Odśwież" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshRecoveryCatalogButton" />
            <Button x:Name="RestoreButton" Content="Przywróć wybraną kopię" Click="Restore_Click" IsEnabled="False" AutomationProperties.AutomationId="RestoreSelectedBackupButton" />
            <Button x:Name="BackButton" Content="Wróć" Click="Back_Click" AutomationProperties.AutomationId="BackFromRecoveryButton" />
            <Button x:Name="CloseButton" Content="Zamknij aplikację" Click="Close_Click" AutomationProperties.AutomationId="CloseFromRecoveryButton" />
        </StackPanel>
    </Grid>
</Window>
