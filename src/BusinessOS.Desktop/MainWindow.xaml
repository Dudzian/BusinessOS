<Window x:Class="BusinessOS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BusinessOS">
 <ScrollViewer><Grid Padding="32" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Text="{Binding Shell.Title}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.Version}"/><TextBlock Text="Baza danych jest gotowa" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Firmy" Click="CompaniesSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="CompaniesSectionButton"/><Button Content="Projekty" Click="ProjectsSection_Click" IsEnabled="{Binding Workspace.CanNavigate}" AutomationProperties.AutomationId="BusinessProjectsSectionButton"/><Button Content="Kopie zapasowe" Click="Recovery_Click" IsEnabled="{Binding Workspace.CanOpenRecovery}" AutomationProperties.AutomationId="OpenRecoveryFromMainButton"/></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding CompaniesVisibility}" Spacing="12" AutomationProperties.AutomationId="CompaniesSectionPanel">
   <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Firmy" FontSize="24"/><Button Content="Dodaj" Click="Add_Click" IsEnabled="{Binding Companies.CanAdd}" AutomationProperties.AutomationId="AddCompanyButton"/><Button Content="Edytuj" Click="Edit_Click" IsEnabled="{Binding Companies.CanEdit}" AutomationProperties.AutomationId="EditCompanyButton"/><Button Content="Archiwizuj" Click="Archive_Click" IsEnabled="{Binding Companies.CanArchive}" AutomationProperties.AutomationId="ArchiveCompanyButton"/><Button Content="Odśwież" Click="Refresh_Click" IsEnabled="{Binding Companies.CanRefresh}" AutomationProperties.AutomationId="RefreshCompaniesButton"/></StackPanel>
   <TextBlock Text="Brak firm. Dodaj pierwszą firmę." Visibility="{Binding CompaniesEmptyVisibility}" AutomationProperties.AutomationId="CompaniesEmptyState"/>
   <ListView ItemsSource="{Binding Companies.Companies}" SelectedItem="{Binding Companies.SelectedCompany, Mode=TwoWay}" IsEnabled="{Binding Companies.CanSelectList}" AutomationProperties.AutomationId="CompaniesList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding LegalName}"/><TextBlock><Run Text="{Binding BaseCurrency}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Visibility="{Binding CompanyEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="CompanyEditorPanel"><TextBox Header="Nazwa prawna" Text="{Binding Companies.LegalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyLegalNameInput"/><TextBox Header="Nazwa wyświetlana" Text="{Binding Companies.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyDisplayNameInput"/><TextBox Header="NIP / numer podatkowy" Text="{Binding Companies.TaxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyTaxIdInput"/><TextBox Header="Kod kraju" Text="{Binding Companies.CountryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyCountryInput"/><TextBox Header="Waluta bazowa" Text="{Binding Companies.BaseCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyCurrencyInput"/><TextBox Header="Strefa czasowa" Text="{Binding Companies.DefaultTimeZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyTimeZoneInput"/><ComboBox Header="Status" SelectedItem="{Binding Companies.Status, Mode=TwoWay}" ItemsSource="{Binding CompanyStatuses}" AutomationProperties.AutomationId="CompanyStatusInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="Save_Click" IsEnabled="{Binding Companies.CanSave}" AutomationProperties.AutomationId="SaveCompanyButton"/><Button Content="Anuluj" Click="Cancel_Click" IsEnabled="{Binding Companies.CanCancel}" AutomationProperties.AutomationId="CancelCompanyButton"/></StackPanel></StackPanel>
   <TextBlock Text="{Binding Companies.OperationMessage}" AutomationProperties.AutomationId="CompanyOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding ProjectsVisibility}" Spacing="12" AutomationProperties.AutomationId="BusinessProjectsSectionPanel">
   <TextBlock Text="Projekty" FontSize="24"/><ComboBox Header="Firma" ItemsSource="{Binding Projects.Companies}" SelectedItem="{Binding Projects.SelectedCompany, Mode=OneWay}" SelectionChanged="BusinessProjectsCompanySelector_SelectionChanged" DisplayMemberPath="DisplayName" IsEnabled="{Binding Projects.CanSelectCompany}" AutomationProperties.AutomationId="BusinessProjectsCompanySelector"/><ComboBox Header="Status (puste = Wszystkie)" ItemsSource="{Binding Projects.StatusFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Projects.SelectedStatusFilter, Mode=OneWay}" SelectionChanged="BusinessProjectsStatusFilter_SelectionChanged" IsEnabled="{Binding Projects.CanChangeFilter}" AutomationProperties.AutomationId="BusinessProjectsStatusFilter"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Odśwież" Click="ProjectsRefresh_Click" IsEnabled="{Binding Projects.CanRefresh}" AutomationProperties.AutomationId="RefreshBusinessProjectsButton"/><Button Content="Dodaj" Click="ProjectAdd_Click" IsEnabled="{Binding Projects.CanAdd}" AutomationProperties.AutomationId="AddBusinessProjectButton"/><Button Content="Edytuj" Click="ProjectEdit_Click" IsEnabled="{Binding Projects.CanEdit}" AutomationProperties.AutomationId="EditBusinessProjectButton"/><Button Content="Zmień status" Click="ProjectStatus_Click" IsEnabled="{Binding Projects.CanChangeStatus}" AutomationProperties.AutomationId="ChangeBusinessProjectStatusButton"/><Button Content="Archiwizuj" Click="ProjectArchive_Click" IsEnabled="{Binding Projects.CanArchive}" AutomationProperties.AutomationId="ArchiveBusinessProjectButton"/></StackPanel>
   <TextBlock Text="Brak projektów." Visibility="{Binding ProjectsEmptyVisibility}" AutomationProperties.AutomationId="BusinessProjectsEmptyState"/>
   <ListView ItemsSource="{Binding Projects.Projects}" SelectedItem="{Binding Projects.SelectedProject, Mode=TwoWay}" IsEnabled="{Binding Projects.CanSelectProject}" AutomationProperties.AutomationId="BusinessProjectsList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding BusinessType}"/><Run Text=" · "/><Run Text="{Binding Location}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock><TextBlock><Run Text="{Binding PlannedStartDate}"/><Run Text=" → "/><Run Text="{Binding PlannedOpeningDate}"/><Run Text=" · "/><Run Text="{Binding BaseCurrency}"/></TextBlock><TextBlock Text="{Binding UpdatedAtUtc}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Visibility="{Binding ProjectEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="BusinessProjectEditorPanel"><TextBox Header="Nazwa projektu" Text="{Binding Projects.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectNameInput"/><TextBox Header="Typ biznesu" Text="{Binding Projects.BusinessType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectTypeInput"/><TextBox Header="Lokalizacja" Text="{Binding Projects.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectLocationInput"/><TextBox Header="Opis" Text="{Binding Projects.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AutomationProperties.AutomationId="BusinessProjectDescriptionInput"/><CalendarDatePicker Header="Planowana data rozpoczęcia" Date="{Binding ProjectStartDate, Mode=TwoWay}" AutomationProperties.AutomationId="BusinessProjectStartDateInput"/><CalendarDatePicker Header="Planowana data otwarcia" Date="{Binding ProjectOpeningDate, Mode=TwoWay}" AutomationProperties.AutomationId="BusinessProjectOpeningDateInput"/><TextBox Header="Waluta bazowa" Text="{Binding Projects.BaseCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BusinessProjectCurrencyInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="ProjectSave_Click" IsEnabled="{Binding Projects.CanSave}" AutomationProperties.AutomationId="SaveBusinessProjectButton"/><Button Content="Anuluj" Click="ProjectCancel_Click" IsEnabled="{Binding Projects.CanCancel}" AutomationProperties.AutomationId="CancelBusinessProjectButton"/></StackPanel></StackPanel>
   <TextBlock Text="{Binding Projects.OperationMessage}" AutomationProperties.AutomationId="BusinessProjectOperationMessage"/>
  </StackPanel>
 </Grid></ScrollViewer>
</Window>
