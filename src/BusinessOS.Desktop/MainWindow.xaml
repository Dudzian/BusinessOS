<Window x:Class="BusinessOS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BusinessOS">
 <ScrollViewer><Grid Padding="32" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="4"><TextBlock Text="{Binding Shell.Title}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.Version}"/><TextBlock Text="Baza danych jest gotowa" FontWeight="SemiBold"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="Firmy" FontSize="24" FontWeight="SemiBold"/><Button Content="Dodaj" Click="Add_Click" IsEnabled="{Binding Companies.CanAdd}" AutomationProperties.AutomationId="AddCompanyButton"/><Button Content="Edytuj" Click="Edit_Click" IsEnabled="{Binding Companies.CanEdit}" AutomationProperties.AutomationId="EditCompanyButton"/><Button Content="Archiwizuj" Click="Archive_Click" IsEnabled="{Binding Companies.CanArchive}" AutomationProperties.AutomationId="ArchiveCompanyButton"/><Button Content="Odśwież" Click="Refresh_Click" IsEnabled="{Binding Companies.CanRefresh}" AutomationProperties.AutomationId="RefreshCompaniesButton"/><Button Content="Kopie zapasowe" Click="Recovery_Click" IsEnabled="{Binding Companies.CanOpenRecovery}" AutomationProperties.AutomationId="OpenRecoveryFromMainButton"/></StackPanel>
  <StackPanel Grid.Row="2"><TextBlock Text="Brak firm. Dodaj pierwszą firmę." Visibility="{Binding EmptyVisibility}" AutomationProperties.AutomationId="CompaniesEmptyState"/>
   <ListView ItemsSource="{Binding Companies.Companies}" SelectedItem="{Binding Companies.SelectedCompany, Mode=TwoWay}" IsEnabled="{Binding Companies.CanSelectList}" AutomationProperties.AutomationId="CompaniesList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding LegalName}"/><TextBlock><Run Text="NIP: "/><Run Text="{Binding TaxIdentificationNumber}"/><Run Text=" · "/><Run Text="{Binding CountryCode}"/><Run Text=" · "/><Run Text="{Binding BaseCurrency}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock><TextBlock Text="{Binding UpdatedAtUtc}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
  </StackPanel>
  <StackPanel Grid.Row="3" Visibility="{Binding EditorVisibility}" Spacing="8" AutomationProperties.AutomationId="CompanyEditorPanel"><TextBlock Text="Dane firmy" FontSize="20"/><TextBox Header="Nazwa prawna" Text="{Binding Companies.LegalName, Mode=TwoWay}" AutomationProperties.AutomationId="CompanyLegalNameInput"/><TextBox Header="Nazwa wyświetlana" Text="{Binding Companies.DisplayName, Mode=TwoWay}" AutomationProperties.AutomationId="CompanyDisplayNameInput"/><TextBox Header="NIP / numer podatkowy" Text="{Binding Companies.TaxId, Mode=TwoWay}" AutomationProperties.AutomationId="CompanyTaxIdInput"/><TextBox Header="Kod kraju" Text="{Binding Companies.CountryCode, Mode=TwoWay}" AutomationProperties.AutomationId="CompanyCountryInput"/><TextBox Header="Waluta bazowa" Text="{Binding Companies.BaseCurrency, Mode=TwoWay}" AutomationProperties.AutomationId="CompanyCurrencyInput"/><TextBox Header="Strefa czasowa" Text="{Binding Companies.DefaultTimeZone, Mode=TwoWay}" AutomationProperties.AutomationId="CompanyTimeZoneInput"/><ComboBox Header="Status" SelectedItem="{Binding Companies.Status, Mode=TwoWay}" ItemsSource="{Binding Statuses}" AutomationProperties.AutomationId="CompanyStatusInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="Save_Click" IsEnabled="{Binding Companies.CanSave}" AutomationProperties.AutomationId="SaveCompanyButton"/><Button Content="Anuluj" Click="Cancel_Click" IsEnabled="{Binding Companies.CanCancel}" AutomationProperties.AutomationId="CancelCompanyButton"/></StackPanel></StackPanel>
  <TextBlock Grid.Row="4" Text="{Binding Companies.OperationMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="CompanyOperationMessage"/>
 </Grid></ScrollViewer>
</Window>
