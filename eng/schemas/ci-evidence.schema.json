{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://businessos.local/schemas/ci-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAtUtc",
    "repository",
    "eventName",
    "workflowName",
    "runId",
    "runAttempt",
    "jobKey",
    "checkoutKind",
    "commitSha",
    "commitTreeSha",
    "pullRequestNumber",
    "pullRequestHeadSha",
    "pullRequestMergeSha",
    "runnerOs",
    "runnerArch",
    "runnerImage",
    "dotnetVersion",
    "powershellVersion",
    "gateName",
    "gateStatus",
    "startedAtUtc",
    "completedAtUtc",
    "durationSeconds",
    "lastCompletedStage",
    "formatStatus",
    "buildStatus",
    "warnings",
    "errors",
    "tests",
    "vulnerabilities",
    "migrations",
    "smoke",
    "failure"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "checkoutKind": {
            "const": "local"
          }
        },
        "required": [
          "checkoutKind"
        ]
      },
      "then": {
        "properties": {
          "runId": {
            "const": 0
          },
          "runAttempt": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "runId": {
            "minimum": 1
          },
          "runAttempt": {
            "minimum": 1
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "eventName": {
      "type": "string",
      "minLength": 1
    },
    "workflowName": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "runAttempt": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "jobKey": {
      "type": "string",
      "minLength": 1
    },
    "checkoutKind": {
      "enum": [
        "pull-request-merge",
        "branch-head",
        "local"
      ]
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commitTreeSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pullRequestNumber": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pullRequestHeadSha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pullRequestMergeSha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runnerOs": {
      "type": "string",
      "minLength": 1
    },
    "runnerArch": {
      "type": "string",
      "minLength": 1
    },
    "runnerImage": {
      "type": "string",
      "minLength": 1
    },
    "dotnetVersion": {
      "type": "string",
      "minLength": 1
    },
    "powershellVersion": {
      "type": "string",
      "minLength": 1
    },
    "gateName": {
      "enum": [
        "cross-platform",
        "windows"
      ]
    },
    "gateStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "lastCompletedStage": {
      "type": "string",
      "minLength": 1
    },
    "formatStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "buildStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered",
        "executed",
        "passed",
        "failed",
        "skipped",
        "trxFiles"
      ],
      "properties": {
        "discovered": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "trxFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "vulnerabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "knownVulnerabilityCount",
        "checkedTargets"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "knownVulnerabilityCount": {
          "type": "integer",
          "minimum": 0
        },
        "checkedTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pendingModelChanges",
        "newMigrationCreated",
        "snapshotModified"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "pendingModelChanges": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "newMigrationCreated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "snapshotModified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredScenarioCount",
        "executedScenarioCount",
        "passedScenarioCount",
        "failedScenarioCount",
        "scenarios"
      ],
      "properties": {
        "requiredScenarioCount": {
          "type": "integer",
          "minimum": 0
        },
        "executedScenarioCount": {
          "type": "integer",
          "minimum": 0
        },
        "passedScenarioCount": {
          "type": "integer",
          "minimum": 0
        },
        "failedScenarioCount": {
          "type": "integer",
          "minimum": 0
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "recoveryOrigin",
              "fixtureValidation",
              "closeDispatchMethod",
              "shutdownMethod",
              "diagnosticFile",
              "fixturePrepared",
              "recoveryOpened",
              "catalogLoaded",
              "restoreDisabledWithoutSelection",
              "confirmationCancelPassed",
              "backNavigationPassed",
              "restoreStarted",
              "restoreSucceeded",
              "postRestoreStartupSucceeded",
              "stableWindowStatePassed",
              "exited",
              "catalogItemCount",
              "validBackupCount",
              "invalidBackupCount",
              "stableSamplesRequired",
              "stableSamplesObserved",
              "finalWindowCount",
              "finalMainWindowCount",
              "finalFailureWindowCount",
              "finalRecoveryWindowCount",
              "exitCode"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_RUN"
                ]
              },
              "recoveryOrigin": {
                "type": "string",
                "minLength": 1
              },
              "fixtureValidation": {
                "type": "string",
                "minLength": 1
              },
              "closeDispatchMethod": {
                "type": "string",
                "minLength": 1
              },
              "shutdownMethod": {
                "type": "string",
                "minLength": 1
              },
              "diagnosticFile": {
                "type": "string",
                "minLength": 1
              },
              "fixturePrepared": {
                "type": "boolean"
              },
              "recoveryOpened": {
                "type": "boolean"
              },
              "catalogLoaded": {
                "type": "boolean"
              },
              "restoreDisabledWithoutSelection": {
                "type": "boolean"
              },
              "confirmationCancelPassed": {
                "type": "boolean"
              },
              "backNavigationPassed": {
                "type": "boolean"
              },
              "restoreStarted": {
                "type": "boolean"
              },
              "restoreSucceeded": {
                "type": "boolean"
              },
              "postRestoreStartupSucceeded": {
                "type": "boolean"
              },
              "stableWindowStatePassed": {
                "type": "boolean"
              },
              "exited": {
                "type": "boolean"
              },
              "catalogItemCount": {
                "type": "integer",
                "minimum": 0
              },
              "validBackupCount": {
                "type": "integer",
                "minimum": 0
              },
              "invalidBackupCount": {
                "type": "integer",
                "minimum": 0
              },
              "stableSamplesRequired": {
                "type": "integer",
                "minimum": 0
              },
              "stableSamplesObserved": {
                "type": "integer",
                "minimum": 0
              },
              "finalWindowCount": {
                "type": "integer",
                "minimum": 0
              },
              "finalMainWindowCount": {
                "type": "integer",
                "minimum": 0
              },
              "finalFailureWindowCount": {
                "type": "integer",
                "minimum": 0
              },
              "finalRecoveryWindowCount": {
                "type": "integer",
                "minimum": 0
              },
              "exitCode": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "maxItems": 5
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "message",
        "diagnosticFiles"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "diagnosticFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "checkoutKind": {
            "const": "pull-request-merge"
          }
        }
      },
      "then": {
        "properties": {
          "pullRequestNumber": {
            "type": "integer",
            "minimum": 1
          },
          "pullRequestHeadSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "pullRequestMergeSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "runId": {
            "type": "integer",
            "minimum": 1
          },
          "runAttempt": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checkoutKind": {
            "const": "local"
          }
        }
      },
      "then": {
        "properties": {
          "pullRequestNumber": {
            "type": "null"
          },
          "pullRequestHeadSha": {
            "type": "null"
          },
          "pullRequestMergeSha": {
            "type": "null"
          },
          "runId": {
            "type": "null"
          },
          "runAttempt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checkoutKind": {
            "const": "branch-head"
          }
        }
      },
      "then": {
        "properties": {
          "runId": {
            "type": "integer",
            "minimum": 1
          },
          "runAttempt": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "migrations": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "migrations": {
            "properties": {
              "pendingModelChanges": {
                "type": "null"
              },
              "newMigrationCreated": {
                "type": "null"
              },
              "snapshotModified": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "migrations": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "migrations": {
            "properties": {
              "pendingModelChanges": {
                "const": false
              },
              "newMigrationCreated": {
                "const": false
              },
              "snapshotModified": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checkoutKind": {
            "const": "branch-head"
          }
        }
      },
      "then": {
        "properties": {
          "pullRequestNumber": {
            "type": "null"
          },
          "pullRequestHeadSha": {
            "type": "null"
          },
          "pullRequestMergeSha": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gateName": {
            "const": "windows"
          },
          "gateStatus": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "smoke": {
            "properties": {
              "requiredScenarioCount": {
                "const": 5
              },
              "executedScenarioCount": {
                "const": 5
              },
              "passedScenarioCount": {
                "const": 5
              },
              "failedScenarioCount": {
                "const": 0
              },
              "scenarios": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "PASS"
                        },
                        "stableSamplesRequired": {
                          "const": 5
                        },
                        "stableSamplesObserved": {
                          "const": 5
                        },
                        "stableWindowStatePassed": {
                          "const": true
                        },
                        "exited": {
                          "const": true
                        },
                        "exitCode": {
                          "const": 0
                        }
                      }
                    },
                    {
                      "oneOf": [
                        {
                          "properties": {
                            "name": {
                              "const": "Ready"
                            },
                            "closeDispatchMethod": {
                              "const": "UIAutomation.WindowPattern.Close"
                            },
                            "shutdownMethod": {
                              "const": "CloseMainWindow"
                            },
                            "finalWindowCount": {
                              "const": 1
                            },
                            "finalMainWindowCount": {
                              "const": 1
                            },
                            "finalFailureWindowCount": {
                              "const": 0
                            },
                            "finalRecoveryWindowCount": {
                              "const": 0
                            },
                            "fixturePrepared": {
                              "const": false
                            },
                            "recoveryOrigin": {
                              "const": "None"
                            }
                          }
                        },
                        {
                          "properties": {
                            "name": {
                              "const": "PersistenceFailureThenReady"
                            },
                            "closeDispatchMethod": {
                              "const": "UIAutomation.WindowPattern.Close"
                            },
                            "shutdownMethod": {
                              "const": "CloseMainWindow"
                            },
                            "finalWindowCount": {
                              "const": 1
                            },
                            "finalMainWindowCount": {
                              "const": 1
                            },
                            "finalFailureWindowCount": {
                              "const": 0
                            },
                            "finalRecoveryWindowCount": {
                              "const": 0
                            },
                            "fixturePrepared": {
                              "const": false
                            },
                            "recoveryOrigin": {
                              "const": "None"
                            }
                          }
                        },
                        {
                          "properties": {
                            "name": {
                              "const": "PersistenceFailure"
                            },
                            "fixturePrepared": {
                              "const": false
                            },
                            "recoveryOrigin": {
                              "const": "None"
                            },
                            "finalWindowCount": {
                              "const": 1
                            },
                            "finalMainWindowCount": {
                              "const": 0
                            },
                            "finalFailureWindowCount": {
                              "const": 1
                            },
                            "finalRecoveryWindowCount": {
                              "const": 0
                            }
                          },
                          "allOf": [
                            {
                              "oneOf": [
                                {
                                  "properties": {
                                    "closeDispatchMethod": {
                                      "const": "CloseButton"
                                    },
                                    "shutdownMethod": {
                                      "const": "CloseButton"
                                    }
                                  }
                                },
                                {
                                  "properties": {
                                    "closeDispatchMethod": {
                                      "const": "UIAutomation.WindowPattern.Close"
                                    },
                                    "shutdownMethod": {
                                      "const": "CloseMainWindow"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "properties": {
                            "name": {
                              "const": "RecoveryFromReady"
                            },
                            "closeDispatchMethod": {
                              "const": "UIAutomation.WindowPattern.Close"
                            },
                            "shutdownMethod": {
                              "const": "CloseMainWindow"
                            },
                            "finalWindowCount": {
                              "const": 1
                            },
                            "finalMainWindowCount": {
                              "const": 1
                            },
                            "finalFailureWindowCount": {
                              "const": 0
                            },
                            "finalRecoveryWindowCount": {
                              "const": 0
                            },
                            "fixturePrepared": {
                              "const": true
                            },
                            "recoveryOrigin": {
                              "const": "MainWindow"
                            },
                            "recoveryOpened": {
                              "const": true
                            },
                            "catalogLoaded": {
                              "const": true
                            },
                            "restoreDisabledWithoutSelection": {
                              "const": true
                            },
                            "confirmationCancelPassed": {
                              "const": true
                            },
                            "backNavigationPassed": {
                              "const": true
                            },
                            "restoreStarted": {
                              "const": true
                            },
                            "restoreSucceeded": {
                              "const": true
                            },
                            "postRestoreStartupSucceeded": {
                              "const": true
                            },
                            "validBackupCount": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "invalidBackupCount": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "fixtureValidation": {
                              "const": "PASS"
                            }
                          }
                        },
                        {
                          "properties": {
                            "name": {
                              "const": "RecoveryFromStartupFailure"
                            },
                            "closeDispatchMethod": {
                              "const": "UIAutomation.WindowPattern.Close"
                            },
                            "shutdownMethod": {
                              "const": "CloseMainWindow"
                            },
                            "finalWindowCount": {
                              "const": 1
                            },
                            "finalMainWindowCount": {
                              "const": 1
                            },
                            "finalFailureWindowCount": {
                              "const": 0
                            },
                            "finalRecoveryWindowCount": {
                              "const": 0
                            },
                            "fixturePrepared": {
                              "const": true
                            },
                            "recoveryOrigin": {
                              "const": "StartupFailure"
                            },
                            "recoveryOpened": {
                              "const": true
                            },
                            "catalogLoaded": {
                              "const": true
                            },
                            "restoreDisabledWithoutSelection": {
                              "const": true
                            },
                            "confirmationCancelPassed": {
                              "const": true
                            },
                            "backNavigationPassed": {
                              "const": true
                            },
                            "restoreStarted": {
                              "const": true
                            },
                            "restoreSucceeded": {
                              "const": true
                            },
                            "postRestoreStartupSucceeded": {
                              "const": true
                            },
                            "validBackupCount": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "invalidBackupCount": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "fixtureValidation": {
                              "const": "PASS"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "Ready"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "PersistenceFailure"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "PersistenceFailureThenReady"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "RecoveryFromReady"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "RecoveryFromStartupFailure"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
