   <TextBlock Text="CAPEX" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetVariance.CapexPlanned}" AutomationProperties.AutomationId="BudgetVarianceCapexPlanned"/><TextBlock Text="{Binding BudgetVariance.CapexActual}" AutomationProperties.AutomationId="BudgetVarianceCapexActual"/><TextBlock Text="{Binding BudgetVariance.CapexVariance}" AutomationProperties.AutomationId="BudgetVarianceCapexVariance"/><TextBlock Text="{Binding BudgetVariance.CapexUtilization}" AutomationProperties.AutomationId="BudgetVarianceCapexUtilization"/><TextBlock Text="{Binding BudgetVariance.CapexState}" AutomationProperties.AutomationId="BudgetVarianceCapexState"/></StackPanel>
   <TextBlock Text="OPEX" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetVariance.OpexPlanned}" AutomationProperties.AutomationId="BudgetVarianceOpexPlanned"/><TextBlock Text="{Binding BudgetVariance.OpexActual}" AutomationProperties.AutomationId="BudgetVarianceOpexActual"/><TextBlock Text="{Binding BudgetVariance.OpexVariance}" AutomationProperties.AutomationId="BudgetVarianceOpexVariance"/><TextBlock Text="{Binding BudgetVariance.OpexUtilization}" AutomationProperties.AutomationId="BudgetVarianceOpexUtilization"/><TextBlock Text="{Binding BudgetVariance.OpexState}" AutomationProperties.AutomationId="BudgetVarianceOpexState"/></StackPanel>
   <TextBlock Text="TOTAL EXPENSES" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetVariance.TotalPlanned}" AutomationProperties.AutomationId="BudgetVarianceTotalPlanned"/><TextBlock Text="{Binding BudgetVariance.TotalActual}" AutomationProperties.AutomationId="BudgetVarianceTotalActual"/><TextBlock Text="{Binding BudgetVariance.TotalVariance}" AutomationProperties.AutomationId="BudgetVarianceTotalVariance"/><TextBlock Text="{Binding BudgetVariance.TotalUtilization}" AutomationProperties.AutomationId="BudgetVarianceTotalUtilization"/><TextBlock Text="{Binding BudgetVariance.TotalState}" AutomationProperties.AutomationId="BudgetVarianceTotalState"/></StackPanel><TextBlock Text="{Binding BudgetVariance.OperationMessage}" AutomationProperties.AutomationId="BudgetVarianceOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding BudgetForecastVisibility}" Spacing="12" AutomationProperties.AutomationId="BudgetForecastSectionPanel">
   <TextBlock Text="Plan vs prognoza" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding BudgetForecast.Projects}" SelectedItem="{Binding BudgetForecast.SelectedProject, Mode=OneWay}" SelectionChanged="BudgetForecastProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding BudgetForecast.CanSelectProject}" AutomationProperties.AutomationId="BudgetForecastProjectSelector"/><ComboBox Header="Budżet" ItemsSource="{Binding BudgetForecast.Budgets}" SelectedItem="{Binding BudgetForecast.SelectedBudget, Mode=OneWay}" SelectionChanged="BudgetForecastBudgetSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding BudgetForecast.CanSelectBudget}" AutomationProperties.AutomationId="BudgetForecastBudgetSelector"/><ComboBox Header="Wersja planu" ItemsSource="{Binding BudgetForecast.Versions}" SelectedItem="{Binding BudgetForecast.SelectedVersion, Mode=OneWay}" SelectionChanged="BudgetForecastVersionSelector_SelectionChanged" DisplayMemberPath="Label" IsEnabled="{Binding BudgetForecast.CanSelectVersion}" AutomationProperties.AutomationId="BudgetForecastVersionSelector"/>
   <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="{Binding BudgetForecast.ProjectCurrency}" AutomationProperties.AutomationId="BudgetForecastCurrency"/><TextBlock Text="{Binding BudgetForecast.BudgetStatus}" AutomationProperties.AutomationId="BudgetForecastBudgetStatus"/><Button Content="Odśwież" Click="BudgetForecastRefresh_Click" IsEnabled="{Binding BudgetForecast.CanRefresh}" AutomationProperties.AutomationId="RefreshBudgetForecastButton"/></StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Plan"/><TextBlock Text="Wykonanie"/><TextBlock Text="Pozostała prognoza (ETC)"/><TextBlock Text="Prognoza końcowa (EAC)"/><TextBlock Text="Odchylenie końcowe (VAC)"/><TextBlock Text="Wykorzystanie EAC"/><TextBlock Text="Stan"/></StackPanel>
   <TextBlock Text="CAPEX" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetForecast.CapexPlanned}" AutomationProperties.AutomationId="BudgetForecastCapexPlanned"/><TextBlock Text="{Binding BudgetForecast.CapexActual}" AutomationProperties.AutomationId="BudgetForecastCapexActual"/><TextBlock Text="{Binding BudgetForecast.CapexEtc}" AutomationProperties.AutomationId="BudgetForecastCapexEtc"/><TextBlock Text="{Binding BudgetForecast.CapexEac}" AutomationProperties.AutomationId="BudgetForecastCapexEac"/><TextBlock Text="{Binding BudgetForecast.CapexVac}" AutomationProperties.AutomationId="BudgetForecastCapexVac"/><TextBlock Text="{Binding BudgetForecast.CapexUtilization}" AutomationProperties.AutomationId="BudgetForecastCapexUtilization"/><TextBlock Text="{Binding BudgetForecast.CapexState}" AutomationProperties.AutomationId="BudgetForecastCapexState"/></StackPanel>
   <TextBlock Text="OPEX" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetForecast.OpexPlanned}" AutomationProperties.AutomationId="BudgetForecastOpexPlanned"/><TextBlock Text="{Binding BudgetForecast.OpexActual}" AutomationProperties.AutomationId="BudgetForecastOpexActual"/><TextBlock Text="{Binding BudgetForecast.OpexEtc}" AutomationProperties.AutomationId="BudgetForecastOpexEtc"/><TextBlock Text="{Binding BudgetForecast.OpexEac}" AutomationProperties.AutomationId="BudgetForecastOpexEac"/><TextBlock Text="{Binding BudgetForecast.OpexVac}" AutomationProperties.AutomationId="BudgetForecastOpexVac"/><TextBlock Text="{Binding BudgetForecast.OpexUtilization}" AutomationProperties.AutomationId="BudgetForecastOpexUtilization"/><TextBlock Text="{Binding BudgetForecast.OpexState}" AutomationProperties.AutomationId="BudgetForecastOpexState"/></StackPanel>
   <TextBlock Text="RAZEM" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BudgetForecast.TotalPlanned}" AutomationProperties.AutomationId="BudgetForecastTotalPlanned"/><TextBlock Text="{Binding BudgetForecast.TotalActual}" AutomationProperties.AutomationId="BudgetForecastTotalActual"/><TextBlock Text="{Binding BudgetForecast.TotalEtc}" AutomationProperties.AutomationId="BudgetForecastTotalEtc"/><TextBlock Text="{Binding BudgetForecast.TotalEac}" AutomationProperties.AutomationId="BudgetForecastTotalEac"/><TextBlock Text="{Binding BudgetForecast.TotalVac}" AutomationProperties.AutomationId="BudgetForecastTotalVac"/><TextBlock Text="{Binding BudgetForecast.TotalUtilization}" AutomationProperties.AutomationId="BudgetForecastTotalUtilization"/><TextBlock Text="{Binding BudgetForecast.TotalState}" AutomationProperties.AutomationId="BudgetForecastTotalState"/></StackPanel>
   <TextBlock Text="{Binding BudgetForecast.OperationMessage}" AutomationProperties.AutomationId="BudgetForecastOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding CostCashFlowVisibility}" Spacing="12" AutomationProperties.AutomationId="CostCashFlowSectionPanel">
   <TextBlock Text="Cash flow kosztów" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding CostCashFlow.Projects}" SelectedItem="{Binding CostCashFlow.SelectedProject, Mode=OneWay}" SelectionChanged="CostCashFlowProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding CostCashFlow.CanSelectProject}" AutomationProperties.AutomationId="CostCashFlowProjectSelector"/>
   <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="Waluta"/><TextBlock Text="{Binding CostCashFlow.ProjectCurrency}" AutomationProperties.AutomationId="CostCashFlowProjectCurrency"/><Button Content="Odśwież" Click="CostCashFlowRefresh_Click" IsEnabled="{Binding CostCashFlow.CanRefresh}" AutomationProperties.AutomationId="RefreshCostCashFlowButton"/></StackPanel>
   <TextBlock Text="CAPEX — Wykonanie / Prognoza / Razem"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding CostCashFlow.CapexActualTotal}" AutomationProperties.AutomationId="CostCashFlowCapexActualTotal"/><TextBlock Text="{Binding CostCashFlow.CapexForecastTotal}" AutomationProperties.AutomationId="CostCashFlowCapexForecastTotal"/><TextBlock Text="{Binding CostCashFlow.CapexExpectedTotal}" AutomationProperties.AutomationId="CostCashFlowCapexExpectedTotal"/></StackPanel>
   <TextBlock Text="OPEX — Wykonanie / Prognoza / Razem"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding CostCashFlow.OpexActualTotal}" AutomationProperties.AutomationId="CostCashFlowOpexActualTotal"/><TextBlock Text="{Binding CostCashFlow.OpexForecastTotal}" AutomationProperties.AutomationId="CostCashFlowOpexForecastTotal"/><TextBlock Text="{Binding CostCashFlow.OpexExpectedTotal}" AutomationProperties.AutomationId="CostCashFlowOpexExpectedTotal"/></StackPanel>
   <TextBlock Text="TOTAL — Wykonanie / Prognoza / Razem"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding CostCashFlow.ActualTotal}" AutomationProperties.AutomationId="CostCashFlowActualTotal"/><TextBlock Text="{Binding CostCashFlow.ForecastTotal}" AutomationProperties.AutomationId="CostCashFlowForecastTotal"/><TextBlock Text="{Binding CostCashFlow.ExpectedTotal}" AutomationProperties.AutomationId="CostCashFlowExpectedTotal"/></StackPanel>
   <TextBlock Text="Brak kosztów do pokazania w cash flow." Visibility="{Binding CostCashFlowEmptyVisibility}" AutomationProperties.AutomationId="CostCashFlowEmptyState"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Miesiąc"/><TextBlock Text="CAPEX wykonanie"/><TextBlock Text="CAPEX prognoza"/><TextBlock Text="CAPEX razem"/><TextBlock Text="OPEX wykonanie"/><TextBlock Text="OPEX prognoza"/><TextBlock Text="OPEX razem"/><TextBlock Text="TOTAL wykonanie"/><TextBlock Text="TOTAL prognoza"/><TextBlock Text="TOTAL razem"/></StackPanel>
   <ListView ItemsSource="{Binding CostCashFlow.Months}" AutomationProperties.AutomationId="CostCashFlowList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" AutomationProperties.Name="{Binding SemanticName}"><TextBlock Text="{Binding MonthLabel}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding CapexActual}"/><TextBlock Text="{Binding CapexForecast}"/><TextBlock Text="{Binding CapexExpected}"/><TextBlock Text="{Binding OpexActual}"/><TextBlock Text="{Binding OpexForecast}"/><TextBlock Text="{Binding OpexExpected}"/><TextBlock Text="{Binding TotalActual}"/><TextBlock Text="{Binding TotalForecast}"/><TextBlock Text="{Binding TotalExpected}"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <TextBlock Text="{Binding CostCashFlow.OperationMessage}" AutomationProperties.AutomationId="CostCashFlowOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding CompaniesVisibility}" Spacing="12" AutomationProperties.AutomationId="CompaniesSectionPanel">
   <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Firmy" FontSize="24"/><Button Content="Dodaj" Click="Add_Click" IsEnabled="{Binding Companies.CanAdd}" AutomationProperties.AutomationId="AddCompanyButton"/><Button Content="Edytuj" Click="Edit_Click" IsEnabled="{Binding Companies.CanEdit}" AutomationProperties.AutomationId="EditCompanyButton"/><Button Content="Archiwizuj" Click="Archive_Click" IsEnabled="{Binding Companies.CanArchive}" AutomationProperties.AutomationId="ArchiveCompanyButton"/><Button Content="Odśwież" Click="Refresh_Click" IsEnabled="{Binding Companies.CanRefresh}" AutomationProperties.AutomationId="RefreshCompaniesButton"/></StackPanel>
   <TextBlock Text="Brak firm. Dodaj pierwszą firmę." Visibility="{Binding CompaniesEmptyVisibility}" AutomationProperties.AutomationId="CompaniesEmptyState"/>
   <ListView ItemsSource="{Binding Companies.Companies}" SelectedItem="{Binding Companies.SelectedCompany, Mode=TwoWay}" IsEnabled="{Binding Companies.CanSelectList}" AutomationProperties.AutomationId="CompaniesList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding LegalName}"/><TextBlock><Run Text="{Binding BaseCurrency}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Visibility="{Binding CompanyEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="CompanyEditorPanel"><TextBox Header="Nazwa prawna" Text="{Binding Companies.LegalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyLegalNameInput"/><TextBox Header="Nazwa wyświetlana" Text="{Binding Companies.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyDisplayNameInput"/><TextBox Header="NIP / numer podatkowy" Text="{Binding Companies.TaxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyTaxIdInput"/><TextBox Header="Kod kraju" Text="{Binding Companies.CountryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyCountryInput"/><TextBox Header="Waluta bazowa" Text="{Binding Companies.BaseCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyCurrencyInput"/><TextBox Header="Strefa czasowa" Text="{Binding Companies.DefaultTimeZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CompanyTimeZoneInput"/><ComboBox Header="Status" SelectedItem="{Binding Companies.Status, Mode=TwoWay}" ItemsSource="{Binding CompanyStatuses}" AutomationProperties.AutomationId="CompanyStatusInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="Save_Click" IsEnabled="{Binding Companies.CanSave}" AutomationProperties.AutomationId="SaveCompanyButton"/><Button Content="Anuluj" Click="Cancel_Click" IsEnabled="{Binding Companies.CanCancel}" AutomationProperties.AutomationId="CancelCompanyButton"/></StackPanel></StackPanel>
   <TextBlock Text="{Binding Companies.OperationMessage}" AutomationProperties.AutomationId="CompanyOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding ActualCostsVisibility}" Spacing="12" AutomationProperties.AutomationId="ActualCostsSectionPanel">
   <TextBlock Text="Koszty rzeczywiste" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding ActualCosts.Projects}" SelectedItem="{Binding ActualCosts.SelectedProject, Mode=OneWay}" SelectionChanged="ActualCostsProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding ActualCosts.CanSelectProject}" AutomationProperties.AutomationId="ActualCostsProjectSelector"/><TextBlock Text="{Binding ActualCosts.ProjectCurrency}" AutomationProperties.AutomationId="ActualCostsProjectCurrency"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Odśwież" Click="ActualCostsRefresh_Click" IsEnabled="{Binding ActualCosts.CanRefresh}" AutomationProperties.AutomationId="RefreshActualCostsButton"/><Button Content="Dodaj" Click="ActualCostAdd_Click" IsEnabled="{Binding ActualCosts.CanAddCost}" AutomationProperties.AutomationId="AddActualCostButton"/><Button Content="Edytuj" Click="ActualCostEdit_Click" IsEnabled="{Binding ActualCosts.CanEditCost}" AutomationProperties.AutomationId="EditActualCostButton"/><Button Content="Archiwizuj" Click="ActualCostArchive_Click" IsEnabled="{Binding ActualCosts.CanArchiveCost}" AutomationProperties.AutomationId="ArchiveActualCostButton"/></StackPanel>
   <TextBlock Text="Brak kosztów." Visibility="{Binding ActualCostsEmptyVisibility}" AutomationProperties.AutomationId="ActualCostsEmptyState"/><ListView ItemsSource="{Binding ActualCosts.Costs}" SelectedItem="{Binding ActualCosts.SelectedCost, Mode=OneWay}" SelectionChanged="ActualCostsList_SelectionChanged" IsEnabled="{Binding ActualCosts.CanSelectCost}" AutomationProperties.AutomationId="ActualCostsList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding Amount}"/><Run Text=" "/><Run Text="{Binding Currency}"/><Run Text=" · "/><Run Text="{Binding IncurredOn}"/></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock AutomationProperties.AutomationId="ActualCostCapexTotal"><Run Text="CAPEX: "/><Run Text="{Binding ActualCosts.CapexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ActualCostOpexTotal"><Run Text="OPEX: "/><Run Text="{Binding ActualCosts.OpexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ActualCostTotal"><Run Text="Total: "/><Run Text="{Binding ActualCosts.TotalCost}"/></TextBlock></StackPanel>
   <StackPanel Visibility="{Binding ActualCostEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="ActualCostEditorPanel"><ComboBox Header="Rodzaj" ItemsSource="{Binding ActualCosts.CostKinds}" SelectedItem="{Binding ActualCosts.CostKind, Mode=TwoWay}" AutomationProperties.AutomationId="ActualCostKindInput"/><TextBox Header="Nazwa" Text="{Binding ActualCosts.CostName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ActualCostNameInput"/><TextBox Header="Kwota" Text="{Binding ActualCosts.CostAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ActualCostAmountInput"/><CalendarDatePicker Header="Data" Date="{Binding ActualCostDate, Mode=TwoWay}" AutomationProperties.AutomationId="ActualCostDateInput"/><TextBox Header="Notatka" Text="{Binding ActualCosts.CostNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ActualCostNoteInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="ActualCostSave_Click" IsEnabled="{Binding ActualCosts.CanSaveCost}" AutomationProperties.AutomationId="SaveActualCostButton"/><Button Content="Anuluj" Click="ActualCostCancel_Click" IsEnabled="{Binding ActualCosts.CanCancelEditor}" AutomationProperties.AutomationId="CancelActualCostButton"/></StackPanel></StackPanel><TextBlock Text="{Binding ActualCosts.OperationMessage}" AutomationProperties.AutomationId="ActualCostsOperationMessage"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Visibility="{Binding ForecastCostsVisibility}" Spacing="12" AutomationProperties.AutomationId="ForecastCostsSectionPanel">
   <TextBlock Text="Prognoza kosztów" FontSize="24"/><ComboBox Header="Projekt" ItemsSource="{Binding ForecastCosts.Projects}" SelectedItem="{Binding ForecastCosts.SelectedProject, Mode=OneWay}" SelectionChanged="ForecastCostsProjectSelector_SelectionChanged" DisplayMemberPath="Name" IsEnabled="{Binding ForecastCosts.CanSelectProject}" AutomationProperties.AutomationId="ForecastCostsProjectSelector"/><TextBlock Text="{Binding ForecastCosts.ProjectCurrency}" AutomationProperties.AutomationId="ForecastCostsProjectCurrency"/>
