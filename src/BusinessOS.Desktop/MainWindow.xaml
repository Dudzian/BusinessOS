   <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock AutomationProperties.AutomationId="ForecastCostCapexTotal"><Run Text="CAPEX: "/><Run Text="{Binding ForecastCosts.ForecastCapexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ForecastCostOpexTotal"><Run Text="OPEX: "/><Run Text="{Binding ForecastCosts.ForecastOpexTotal}"/></TextBlock><TextBlock AutomationProperties.AutomationId="ForecastCostTotal"><Run Text="Total: "/><Run Text="{Binding ForecastCosts.ForecastTotal}"/></TextBlock></StackPanel>
   <StackPanel Visibility="{Binding ForecastCostEditorVisibility}" Spacing="8" AutomationProperties.AutomationId="ForecastCostEditorPanel"><ComboBox Header="Rodzaj" ItemsSource="{Binding ForecastCosts.ForecastKinds}" SelectedItem="{Binding ForecastCosts.ForecastKind, Mode=TwoWay}" AutomationProperties.AutomationId="ForecastCostKindInput"/><TextBox Header="Nazwa" Text="{Binding ForecastCosts.ForecastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ForecastCostNameInput"/><TextBox Header="Kwota" Text="{Binding ForecastCosts.ForecastAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ForecastCostAmountInput"/><CalendarDatePicker Header="Data" Date="{Binding ForecastCostExpectedDate, Mode=TwoWay}" AutomationProperties.AutomationId="ForecastCostExpectedDateInput"/><TextBox Header="Notatka" Text="{Binding ForecastCosts.ForecastNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ForecastCostNoteInput"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Zapisz" Click="ForecastCostSave_Click" IsEnabled="{Binding ForecastCosts.CanSaveForecast}" AutomationProperties.AutomationId="SaveForecastCostButton"/><Button Content="Anuluj" Click="ForecastCostCancel_Click" IsEnabled="{Binding ForecastCosts.CanCancelEditor}" AutomationProperties.AutomationId="CancelForecastCostButton"/></StackPanel></StackPanel><TextBlock Text="{Binding ForecastCosts.OperationMessage}" AutomationProperties.AutomationId="ForecastCostsOperationMessage"/>
  </StackPanel>
